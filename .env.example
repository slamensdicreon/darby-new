# Public site URL, used for canonical URLs, sitemap.xml and structured data.
NEXT_PUBLIC_SITE_URL=https://darbyinc.com

# --- Form email delivery (Resend) ---
# API key from https://resend.com/api-keys. Without it, submissions are only logged.
RESEND_API_KEY=
# Where notifications go. Use a test inbox first, then info@darbyinc.com.
MAIL_TO=info@darbyinc.com
# Sender. Until darbyinc.com is verified in Resend, leave unset: Resend's onboarding
# sender is used and delivers only to the Resend account's own email address.
# After verification: MAIL_FROM="Darby Website <website@darbyinc.com>"
MAIL_FROM=

# Optional: also POST each submission as JSON to a webhook (Zapier, Make, a CRM).
CONTACT_WEBHOOK_URL=
SPEC_WEBHOOK_URL=
