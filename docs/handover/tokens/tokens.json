{
  "color": {
    "color-frond": "#1E3B2F",
    "color-deep": "#132A22",
    "color-olein": "#D9A13B",
    "color-kernel": "#F3EDE2",
    "color-ink": "#14161A",
    "color-white": "#FFFFFF",
    "color-gold-text": "#8A5F10",
    "color-muted-on-dark": "#C9C2B3",
    "color-muted-on-light": "#4A5249",
    "color-error": "#A3301F",
    "color-image-ground": "#EAE3D6"
  },
  "line": {
    "line-on-dark": "rgba(243, 237, 226, 0.16)",
    "line-on-light": "rgba(20, 22, 26, 0.14)"
  },
  "border": {
    "border-input": "rgba(20, 22, 26, 0.30)"
  },
  "hero": {
    "hero-shade": "linear-gradient(90deg, rgba(19,42,34,0.86) 0%, rgba(19,42,34,0.80) 50%, rgba(19,42,34,0.50) 75%, rgba(19,42,34,0.28) 100%)",
    "hero-shade-tablet": "linear-gradient(90deg, rgba(19,42,34,0.86) 0%, rgba(19,42,34,0.80) 70%, rgba(19,42,34,0.55) 100%)",
    "hero-shade-phone": "rgba(19,42,34,0.82)",
    "hero-home-height": "clamp(560px, calc(100svh - 73px), 820px)",
    "hero-division-height": "clamp(540px, calc(100svh - 73px), 800px)"
  },
  "font": {
    "font-family": "'Hanken Grotesk', 'Helvetica Neue', Arial, sans-serif"
  },
  "weight": {
    "weight-regular": "400",
    "weight-medium": "500",
    "weight-semibold": "600"
  },
  "text": {
    "text-hero": "clamp(44px, min(6.2vw, 10.5svh), 88px)",
    "text-page-title": "clamp(44px, min(5.6vw, 9.6svh), 80px)",
    "text-cta-title": "clamp(40px, 4.8vw, 68px)",
    "text-section-title": "clamp(34px, 4vw, 56px)",
    "text-row-title": "clamp(34px, 3.6vw, 52px)",
    "text-proof-number": "clamp(48px, 5vw, 72px)",
    "text-lead": "clamp(17px, 2.7svh, 20px)",
    "text-body-lg": "18px",
    "text-body": "16px",
    "text-small": "15px",
    "text-label": "12px",
    "text-button": "15px"
  },
  "container": {
    "container-max": "1280px",
    "container-pad": "clamp(20px, 4vw, 56px)"
  },
  "header": {
    "header-height": "72px"
  },
  "section": {
    "section-pad": "128px"
  },
  "radius": {
    "radius": "2px"
  },
  "tap": {
    "tap-min": "44px"
  },
  "ease": {
    "ease-out": "cubic-bezier(.2, .7, .2, 1)"
  },
  "dur": {
    "dur-image-zoom": ".6s"
  }
}